<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header"
        layout="@layout/header"/>
    <com.google.android.youtube.player.YouTubePlayer
        android:layout_gravity="center_horizontal"
        android:id="@+id/player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"/>
    <com.google.android.youtube.ui.TabRow
        android:id="@+id/tabrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.google.android.youtube.ui.Workspace
        android:id="@+id/workspace"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/watch_video_info"/>
        <ListView
            android:orientation="vertical"
            android:id="@+id/related_list"
            android:tag="@string/video_info_related_label_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ListView
            android:orientation="vertical"
            android:id="@+id/comments"
            android:tag="@string/comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.youtube.ui.Workspace>
</LinearLayout>
