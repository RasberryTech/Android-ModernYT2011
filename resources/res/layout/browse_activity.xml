<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/header"/>
    <com.google.android.youtube.ui.TabRow
        android:id="@+id/tabrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.google.android.youtube.ui.Workspace
        android:id="@+id/workspace"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/most_viewed"
            android:tag="@string/most_viewed_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ListView
            android:id="@+id/top_rated"
            android:tag="@string/top_rated_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ListView
            android:id="@+id/most_discussed"
            android:tag="@string/most_discussed_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ListView
            android:id="@+id/top_favorited"
            android:tag="@string/top_favorited_videos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.youtube.ui.Workspace>
</LinearLayout>
