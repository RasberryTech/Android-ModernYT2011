<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:drawable/list_selector_background"
    android:paddingTop="7dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/video_frame"
        android:background="@drawable/video_frame"
        android:padding="1px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1dp">
        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="@dimen/thumbnail_width"
            android:layout_height="@dimen/thumbnail_height"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/extra_small_font_size"
        android:textColor="@color/light_grey"
        android:id="@+id/duration"
        android:background="@color/black"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:maxLines="1"
        android:layout_alignRight="@+id/video_frame"
        android:layout_alignBottom="@+id/video_frame"/>
    <View
        android:duplicateParentState="false"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_below="@+id/video_frame"
        android:layout_alignLeft="@+id/video_frame"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/more"
        android:paddingRight="2dp"
        android:focusable="false"
        android:visibility="gone"
        android:duplicateParentState="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/thumbnail_height"
        android:layout_alignParentRight="true"/>
    <RelativeLayout
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_toLeftOf="@+id/more"
        android:layout_toRightOf="@+id/video_frame"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/small_font_size"
            android:textStyle="bold"
            android:textColor="@color/white_text"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="@dimen/extra_small_font_size"
            android:textColor="@color/grey_text"
            android:id="@+id/author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_below="@+id/title"
            android:layout_alignLeft="@+id/title"/>
        <TextView
            android:textSize="@dimen/extra_small_font_size"
            android:textColor="@color/red"
            android:id="@+id/recent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="@string/recent"
            android:layout_toRightOf="@+id/author"
            android:layout_below="@+id/title"
            android:layout_alignTop="@+id/author"/>
        <TextView
            android:textSize="@dimen/extra_small_font_size"
            android:textColor="@color/grey_text"
            android:ellipsize="end"
            android:id="@+id/detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_below="@+id/author"
            android:layout_alignLeft="@+id/title"/>
    </RelativeLayout>
</RelativeLayout>
